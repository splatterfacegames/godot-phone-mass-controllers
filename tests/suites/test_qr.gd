func run(t) -> void:
	t.section("golden matrices vs qrcode npm")
	for g: Dictionary in GOLDEN:
		var m := PMCQr.encode_advanced(g.text, g.ecc, g.version, g.version, g.mask, g.mode)
		t.ok(m != null, "encodes %s" % g.text)
		if m == null:
			continue
		t.eq(m.size, (g.rows as Array).size(), "size for %s" % g.text)
		var diff := 0
		var rows := m.to_rows()
		for y in rows.size():
			for x in rows[y].length():
				if rows[y][x] != (g.rows[y] as String)[x]:
					diff += 1
		t.eq(diff, 0, "module differences for %s (v%d mask %d)" % [g.text, g.version, g.mask])

	t.section("auto version and mode")
	var url := PMCQr.encode("http://192.168.1.87:8086/?code=ABCD")
	t.eq(url.version, 3, "LAN URL at M fits version 3")
	t.eq(url.mode, "byte")
	t.eq(url.ecc, PMCQr.ECC_M, "default level is M")
	t.eq(url.size, 29)
	t.eq(PMCQr.encode("HELLO WORLD", 2).mode, "alphanumeric")
	t.eq(PMCQr.encode("0123456789").mode, "numeric")
	t.eq(PMCQr.encode("").version, 1, "empty text encodes")
	t.eq(PMCQr.encode("https://random-words-here.trycloudflare.com/?code=WXYZ", 0).version, 4)
	t.eq(PMCQr.encode("https://random-words-here.trycloudflare.com/?code=WXYZ", 3).version, 6)

	t.section("capacity limits")
	# Version 1-L holds 17 bytes, version 40-L 2953 bytes, version 40-H 1273 bytes.
	t.eq(PMCQr.encode("a".repeat(17), 0).version, 1)
	t.eq(PMCQr.encode("a".repeat(18), 0).version, 2)
	t.eq(PMCQr.encode("a".repeat(2953), 0).version, 40)
	t.ok(PMCQr.encode("a".repeat(2954), 0) == null, "2954 bytes at L does not fit")
	t.ok(PMCQr.encode("a".repeat(1274), 3) == null, "1274 bytes at H does not fit")
	t.eq(PMCQr.encode("7".repeat(7089), 0).version, 40, "7089 digits fit version 40-L")
	t.ok(PMCQr.encode_advanced("abc", 1, 1, 1, -1, "numeric") == null, "invalid numeric text rejected")
	t.ok(PMCQr.encode_advanced("abc", 1, 1, 1, -1, "kanji") == null, "unknown mode rejected")

	t.section("structure")
	var big := PMCQr.encode("x".repeat(500), 1)
	t.eq(big.version, 17, "500 bytes at M need version 17")
	for m: PMCQrMatrix in [url, big]:
		# Finder pattern corners and timing pattern.
		t.ok(m.get_module(0, 0) and m.get_module(6, 6) and not m.get_module(7, 7), "top-left finder")
		t.ok(m.get_module(m.size - 1, 0) and m.get_module(0, m.size - 1), "other finders")
		t.ok(m.get_module(8, m.size - 8), "dark module")
		var timing_ok := true
		for i in range(8, m.size - 8):
			if m.get_module(i, 6) != (i % 2 == 0) or m.get_module(6, i) != (i % 2 == 0):
				timing_ok = false
		t.ok(timing_ok, "timing patterns v%d" % m.version)
		t.ok(not m.get_module(-1, 0) and not m.get_module(m.size, 0), "out of range is light")
	t.ok(big.modules.count(1) > big.size * big.size * 0.4 and big.modules.count(1) < big.size * big.size * 0.6, "dark balance")

	t.section("mask selection")
	var auto := PMCQr.encode("http://192.168.1.87:8086/?code=ABCD", 1)
	var penalties: Array[int] = []
	for msk in 8:
		var forced := PMCQr.encode_advanced("http://192.168.1.87:8086/?code=ABCD", 1, 1, 40, msk)
		t.eq(forced.mask, msk)
		var lay := PMCQr._layout(forced.version)
		var w := forced.size + 1
		var n := forced.size * w + 1
		var r := PackedByteArray()
		r.resize((n + 7) & ~7)
		r.fill(2)
		var c := r.duplicate()
		for y in forced.size:
			for x in forced.size:
				var v := 1 if forced.get_module(x, y) else 0
				r[y * w + 1 + x] = v
				c[x * w + 1 + y] = v
		penalties.append(PMCQr._penalty(r, c, forced.size))
	t.eq(penalties[auto.mask], penalties.min(), "auto mask has the lowest penalty (%s)" % [penalties])

	t.section("to_image")
	var img := PMCQr.to_image(url, 8, 4)
	t.eq(img.get_format(), Image.FORMAT_RGB8)
	t.eq(img.get_width(), (29 + 8) * 8)
	t.eq(img.get_height(), (29 + 8) * 8)
	t.eq(img.get_pixel(0, 0), Color.WHITE, "quiet zone is white")
	t.eq(img.get_pixel(4 * 8 + 3, 4 * 8 + 3), Color.BLACK, "first module is black")
	var mismatch := 0
	for y in url.size:
		for x in url.size:
			var px := img.get_pixel((x + 4) * 8 + 4, (y + 4) * 8 + 4)
			if (px == Color.BLACK) != url.get_module(x, y):
				mismatch += 1
	t.eq(mismatch, 0, "every module rendered")
	t.eq(PMCQr.to_image(url, 1, 0).get_width(), 29, "1 px, no quiet zone")

	t.section("timing")
	PMCQr.encode("http://192.168.1.87:8086/?code=ABCD")
	var iters := 20
	var t0 := Time.get_ticks_usec()
	for i in iters:
		PMCQr.encode("http://192.168.1.87:8086/?code=ABCD")
	var ms := (Time.get_ticks_usec() - t0) / 1000.0 / iters
	t.note("typical URL encode: %.2f ms (version %d)" % [ms, url.version])
	t.ok(ms < 50.0, "encode stays well under a frame (target < 10 ms on an idle machine), got %.2f ms" % ms)
